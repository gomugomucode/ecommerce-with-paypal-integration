# =================================================================
# VELORA STORE - PAYPAL ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to '.env' and replace the placeholder below with
# your actual PayPal Sandbox Client ID from developer.paypal.com

# PayPal Sandbox Client Credentials (Public Frontend Key)
PAYPAL_SANDBOX_CLIENT_ID=MY_SANDBOX_CLIENT_ID

# PayPal Transaction Currency
PAYPAL_CURRENCY=USD

# Environment ('sandbox' for testing, 'production' for live site)
PAYPAL_ENVIRONMENT=sandbox

# =================================================================
# PRODUCTION BACKEND NOTE (Do NOT store Secret Key on frontend)
# =================================================================
# When building a backend server (Node.js/Express, Python, PHP, etc.),
# store your PayPal API Secret Key ONLY on the server:
# PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
